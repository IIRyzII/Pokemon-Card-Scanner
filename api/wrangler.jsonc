{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "pokevault-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "vars": {
    // Web origins allowed to call the API (your GitHub Pages site + local dev).
    "ALLOWED_ORIGINS": "https://iiryzii.github.io,http://localhost:5173,http://127.0.0.1:5173",
    // Currency the collection is valued in: GBP, USD, EUR, CAD or AUD. Everyone can also
    // pick their own display currency in the app (Account → Currency).
    "CURRENCY": "GBP",
    // "open": anyone can sign up but starts as Pending until an admin approves them.
    // "closed": only the very first account (which becomes admin) can sign up.
    "REGISTRATION": "open",
    // The card catalog the web app publishes: the API takes Cardmarket's prices from it (checked
    // links to Cardmarket's own price guide; TCGdex's copy links some cards to the wrong product).
    "CATALOG_URL": "https://iiryzii.github.io/Pokemon-Card-Scanner/catalog"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pokevault",
      // Created with `npx wrangler d1 create pokevault` (see README).
      "database_id": "66775561-ca79-4f3a-aaa3-27846ba54118",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    // Hourly: refresh prices for cards in the collection that are more than ~20h old.
    "crons": ["23 * * * *"]
  }
  // Optional secret (paid PriceCharting subscription, adds graded prices):
  //   npx wrangler secret put PRICECHARTING_TOKEN
}
