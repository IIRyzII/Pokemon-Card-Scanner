{
  "name": "pokevault-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler d1 migrations apply pokevault --local && wrangler dev",
    "deploy": "wrangler d1 migrations apply pokevault --remote && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply pokevault --local",
    "db:migrate:remote": "wrangler d1 migrations apply pokevault --remote",
    "typecheck": "tsc --noEmit",
    "test": "node test/api.test.mjs"
  },
  "dependencies": {
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261014.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.151.0"
  }
}
