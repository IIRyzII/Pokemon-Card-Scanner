{
  "name": "pokevault",
  "private": true,
  "description": "PokéVault — scan, price and track a Pokémon card collection. Phone-friendly web app (GitHub Pages) + our own API (Cloudflare Workers + D1).",
  "workspaces": [
    "web",
    "api"
  ],
  "scripts": {
    "catalog": "node --experimental-strip-types scripts/build-catalog.mjs",
    "catalog:download": "node scripts/download-catalog.mjs",
    "dev:web": "npm run dev --workspace web",
    "dev:api": "npm run dev --workspace api",
    "build": "npm run build --workspace web",
    "typecheck": "npm run typecheck --workspace web && npm run typecheck --workspace api",
    "pretest": "node scripts/download-catalog.mjs --if-missing",
    "test": "node --test --experimental-strip-types \"shared/**/*.test.ts\" \"web/src/**/*.test.ts\""
  },
  "engines": {
    "node": ">=22.12"
  },
  "devDependencies": {
    "jpeg-js": "^0.4.4"
  }
}
